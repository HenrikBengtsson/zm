#! /usr/bin/env bash
#' zm - Quickly Connect to a Zoom Meeting
#'
#' Usage:
#'  zm [options] <command> (shortcut|id|zoom_url|how)
#'
#' Commands:
#'  info        Show address book or details for a specific contact
#'  join        Join a meeting
#'  kill        Kill all Zoom processes of yours
#'  test <how>  Run a test, e.g. 'mic' or 'webrtc' (default)
#'
#' Options:
#'  --mictest   Run a microphone test before joining meeting
#'  --dryrun    Run it through without Zoom actions
#'  --help      Display this help
#'  --version   Display version
#'  --debug     Extra debug outpu
#'
#' Examples:
#'  zm info alice
#'  zm join alice
#'  zm join --mictest alice
#'  zm kill
#'  zm info
#'
#' Configuration:
#' In order to use a shortcut (e.g. 'alice') to connect to a Zoom
#' meeting, an 'alice' entry that specifies the Zoom meeting ID and
#' the optional Zoom meeting password must be added to the address-book
#' file '$XDG_CONFIG_HOME/zm/zm-addressbook', where environment
#' variable 'XDG_CONFIG_HOME' defaults to '~/config'. If directory
#' '$XDG_CONFIG_HOME/zm/' does not exists, '~/.zoom/zm-addressbook' is
#' considered for backward compatibility reasons.
#' For example:
#'
#' shortcut: alice
#' meeting: 123456789
#' password: ZzxYmrldQVVW09y0RYdwMDctcPVdE22O
#' comment: Meetings every Monday @ 10:00-11:00
#'
#' Additional entries can be added the same way. There must be at
#' least one empty line inbetween entries.
#'
#' Version: 0.1.0-9001
#'
#' Copyright: Henrik Bengtsson (2020-2026)
#' License: GPL (>= 3.0) [https://www.gnu.org/licenses/gpl.html]
#' Source: https://github.com/HenrikBengtsson/zm
call="$0 $*"

# -------------------------------------------------------------------------
# Output utility functions
# -------------------------------------------------------------------------
_tput() {
    if [[ $theme == "none" ]]; then
	return
    fi
    tput "$@" 2> /dev/null
}

mdebug() {
    if ! $debug; then
        return
    fi
    {
        _tput setaf 8 ## gray
        echo "DEBUG: $*"
        _tput sgr0    ## reset
    } 1>&2
}

merror() {
    {
        _tput setaf 1 ## red
        echo "ERROR: $*"
        _tput sgr0    ## reset
    } 1>&2
    _exit 1
}

minfo() {
    if ! $verbose; then
        return
    fi
    {
        _tput setaf 4 ## blue
        echo "INFO: $*"
        _tput sgr0    ## reset
    } 1>&2
}

_exit() {
    local value
    
    value=${1:-0}
    mdebug "Exiting with exit code $value"
    exit "$value"
}


# -------------------------------------------------------------------------
# CLI utility functions
# -------------------------------------------------------------------------
version() {
    grep -E "^#'[ ]*Version:[ ]*" "$0" | sed "s/#'[ ]*Version:[ ]*//g"
}

help() {
    local what res
    
    what=$1
    res=$(grep "^#'" "$0" | sed -E "s/^#'(| )//")
    
    if [[ $what == "full" ]]; then
	res=$(echo "$res" | sed '/^---/d')
    else
	res=$(echo "$res" | sed '/^---/Q')
    fi
    
    printf "%s\\n" "${res[@]}"
}


# -------------------------------------------------------------------------
# Audio & video functions
# -------------------------------------------------------------------------
mic_info() {
    local src
    src=$(pactl info | grep -F "Default Source: " | sed 's/Default Source: //')
    echo "$src"
}

mic_find() {
    local name
    local ans
    local res
    name=$1
    mdebug "Finding microphone source"
    mdebug " - name: '${name}'"
    [[ -z $name ]] && merror "Microphone not specified"
    mapfile -t ans < <(pactl list short sources | grep -iF "$name")
    mdebug " - number of matches: ${#ans[*]}"
    [[ ${#ans[*]} -eq 0 ]] && merror "No such microphone found: '$name'"
    for kk in "${!ans[@]}"; do
      mdebug " - entry #${kk}: ${ans[${kk}]}"
    done
    if [[ ${#ans[*]} -gt 1 ]]; then
        mdebug " - using first entry"
    fi
    res=$(echo "${ans[0]}" | cut -f 2)
    mdebug " - full name: '${res}'"
    [[ -z $res ]] && merror "Failed to infer full microphone name: '$name'"
    echo "$res"
}

mic_set() {
    local name
    local fullname
    name=$1
    mdebug "Setting default microphone ..."
    mdebug " - name: '$name'"
    fullname=$(mic_find "$name")
    mdebug " - full name: '$fullname'"
    pactl set-default-source "$fullname" || merror "Failed to set default microphone to '$fullname'"
    mdebug " - default source: '$(mic_info)'"
    minfo "Default microphone: $(mic_info)"
    pactl info
}

mic_test() {
    local duration
    duration=${1:-6}
    mdebug "Using 'arecord' to display microphone input ..."
    minfo "Microphone test:"
    minfo "  - source: $(mic_info)"
    if [[ $duration -eq 0 ]]; then
        minfo "  - Press Ctrl-C when done ..."
    else
        minfo "  - Running for ${duration} seconds ..."
    fi
#    _tput setaf 4 ## blue
    _tput setaf 3 ## yellow
    arecord --quiet --vumeter=mono --duration="${duration}" /dev/null
    exit_value=$?
    echo
    _tput sgr0    ## reset
    return "${exit_value}"
}


# -------------------------------------------------------------------------
# Zoom functions
# -------------------------------------------------------------------------
# https://marketplace.zoom.us/docs/guides/guides/client-url-schemes
zoom_url() {
    type=$1
    action=$2
    confno=$3
    pwd=$4
    [[ -n "$type" ]] || merror "Type of Zoom URL not specified"
    [[ -n "$confno" ]] || merror "Meeting ID not specified"
    if [[ $type == "browser" ]]; then
        url="https://zoom.us/wc/join/$confno"
        if [[ -n "$pwd" ]]; then
            url="${url}?pwd=$pwd"
        fi
    elif [[ $type == "client" ]]; then
        url="zoommtg://zoom.us/$action?confno=$confno"
        if [[ -n "$pwd" ]]; then
            url="${url}&pwd=$pwd"
        fi
    elif [[ $type == "generic" ]]; then
        url="https://zoom.us/j/$confno"
        if [[ -n "$pwd" ]]; then
            url="${url}?pwd=$pwd"
        fi
    else
        merror "Unknown type of Zoom URL: '$type'"
    fi
    mdebug "URL: $url"
    echo "$url"
}


zoom_validate_meeting_id() {
    local id
    id=$1
    [[ ${id} =~ ^[0-9]+$ ]] || merror "Not a valid Zoom Meeting ID: '$id'"
    [[ ${#id} -eq 9 ]] || [[ ${#id} -eq 10 ]]|| [[ ${#id} -eq 11 ]] || merror "Not a valid Zoom Meeting ID: '$id'"
}

zoom_validate_meeting_pwd() {
    local pwd
    pwd=$1
    [[ -z $pwd ]] && return
    [[ ${pwd} =~ ^[0-9a-zA-Z.]+$ ]] || merror "Not a valid Zoom Meeting password: '$pwd'"
}


is_zoom_url() {
    echo "$1" | grep -q "https://.*[.]zoom[.]us/*"
}

zoom_parse_url() {
    local url
    local baseurl
    local pwd
    url=$1
    mdebug "url=$url"
    baseurl=${url%%[?]*}
    mdebug "baseurl=$baseurl"
    query=${url//$baseurl/}
    id=${baseurl//https:\/\/*.zoom.us*\//}
    mdebug "id=$id"
    zoom_validate_meeting_id "$id"
    if [[ -n $query ]]; then
      query=${query//[?]/}
      mdebug "query=$query"
      pwd=${query//pwd=/}
      mdebug "pwd=$pwd"
      zoom_validate_meeting_pwd "$pwd"
    fi
    echo "$id"
    echo "$pwd"
}

xdg_config_home() {
    echo "${XDG_CONFIG_HOME:-$HOME/.config}"
}

## Address book
zm_addressbook_file() {
    local file path
    path=$(xdg_config_home)/zm
    if [[ ! -d "$path" ]]; then
        path="$HOME/.zoom"
    fi
    [[ -d "$path" ]] || merror "No such directory: $path"
    file="$path/zm-addressbook"
    [[ -f "$file" ]] || merror "No such file: $file"
    echo "$file"
}

zm_addressbook_exists() {
    local file
    file=$(zm_addressbook_file)
    grep -q -F "$1" "$file"
}

zm_addressbook_get() {
    local file
    file=$(zm_addressbook_file)
    grep -q -E "shortcut:[ ]+$1" "$file" || merror "Shortcut '$1' does not existing: $file"
    info=$(sed -E -n "/shortcut:[ ]+$1/,/^ *$/p" "$file")
    shortcut=$(echo "$info" | grep -F "shortcut:" | sed -E 's/[[:alpha:]]+: //g')
    meeting=$(echo "$info" | grep -F "meeting:" | sed -E 's/[[:alpha:]]+: //g')
    password=$(echo "$info" | grep -F "password:" | sed -E 's/[[:alpha:]]+: //g')
    comment=$(echo "$info" | grep -F "comment:" | sed -E 's/[[:alpha:]]+: //g')
    echo "$shortcut"
    echo "$meeting"
    echo "$password"
    echo "${comment[*]}"
}

zoom_quick_meeting_shortcut() {
    local res
    readarray -t res <<< "$(zm_addressbook_get "$1")"
    echo "${res[0]}"
}

zoom_quick_meeting_id() {
    local res
    readarray -t res <<< "$(zm_addressbook_get "$1")"
    echo "${res[1]}"
}

zoom_quick_meeting_pwd() {
    local res
    readarray -t res <<< "$(zm_addressbook_get "$1")"
    echo "${res[2]}"
}

zoom_quick_meeting_comment() {
    local res
    readarray -t res <<< "$(zm_addressbook_get "$1")"
    echo "${res[3]}"
}


# -------------------------------------------------------------------------
# MAIN
# -------------------------------------------------------------------------
## General
theme=color
debug=false
verbose=true
dryrun=false
mictest=false

## Actions
action="help"

## Zoom options
meeting_label=
meeting_id=
meeting_pwd=
meeting_pwd_label="<none>"
meeting_target="client"

launcher=xdg-open

# Parse command-line options
while [[ $# -gt 0 ]]; do
    mdebug "Next CLI argument: $1"
    ## Commands:
    if [[ "$1" == "info" ]]; then
        action="info"
        
    elif [[ "$1" == "mictest" ]]; then
        action="mictest"
    
    elif [[ "$1" == "join" ]]; then
        action="join"
    
    elif [[ "$1" == "kill" ]]; then
        action="kill"

    elif [[ "$1" == "test" ]]; then
        action="test"

    elif [[ "$1" == "addressbook" ]]; then
        action="addressbook"

    ## Options (--flags):
    elif [[ "$1" == "--help" ]]; then
        action="help"
    elif [[ "$1" == "--version" ]]; then
        action="version"
    elif [[ "$1" == "--debug" ]]; then
        debug=true
    elif [[ "$1" == "--verbose" ]]; then
        verbose=true
    elif [[ "$1" == "--mictest" ]]; then
        mictest=true
    elif [[ "$1" == "--dryrun" ]]; then
        dryrun=true
    elif [[ "$1" == "--dry-run" ]]; then
        merror "Did you mean to use '--dryrun'?"
	
    ## Options (--key=value):
    elif [[ "$1" =~ ^--.*=.*$ ]]; then
        key=${1//--}
        key=${key//=*}
        value=${1//--[[:alpha:]]*=}
	mdebug "Key-value option '$1' parsed to key='$key', value='$value'"
        if [[ -z $value ]]; then
	    merror "Option '--$key' must not be empty"
	fi
        if [[ "$key" == "pwd" ]]; then
            meeting_pwd=$value
            meeting_pwd_label="<password>"
        elif [[ "$key" == "target" ]]; then
            meeting_target=$value
        elif [[ "$key" == "launcher" ]]; then
            launcher=$value
        elif [[ "$key" == "theme" ]]; then
            theme=$value
        elif [[ "$key" == "mic" ]]; then
            mic=$value
            mic_find "$mic"
        fi

    ## Additional options to be appended (rarely needed)
    else
        meeting_id="$1"
    fi
    shift
done


## --help should always be available prior to any validation errors
if [[ -z $action ]]; then
    help
    _exit 0
elif [[ $action == "help" ]]; then
    help full
    _exit 0
elif [[ $action == "version" ]]; then
    version
    _exit 0
fi


# -------------------------------------------------------------------------
# Validate options
# -------------------------------------------------------------------------
if [[ ${action} != "test" ]] && [[ -n "$meeting_id" ]]; then
    if zm_addressbook_exists "$meeting_id"; then
        meeting_label="$meeting_id"
        mdebug "Detected quick name: '$meeting_label'"
        meeting_label=$(zoom_quick_meeting_shortcut "$meeting_label")
        meeting_id=$(zoom_quick_meeting_id "$meeting_label")
        meeting_pwd=$(zoom_quick_meeting_pwd "$meeting_label")
    elif is_zoom_url "$meeting_id"; then
        ## This requires Bash (>= 4)
        mapfile -t res < <(zoom_parse_url "$meeting_id")
        meeting_id=${res[0]}
        meeting_pwd=${res[1]}
        mdebug "meeting_id=$meeting_id"
        mdebug "meeting_pwd=$meeting_pwd"
    fi
    if [[ -n "$meeting_pwd" ]]; then
        meeting_pwd_label="<password>"
    fi
    mdebug " -> meeting id   : '$meeting_id'"
    mdebug " -> meeting pwd  : '$meeting_pwd_label'"
    zoom_validate_meeting_id "$meeting_id"
    zoom_validate_meeting_pwd "$meeting_pwd"
fi         


# -------------------------------------------------------------------------
# Initiate
# -------------------------------------------------------------------------
mdebug "call: $call"
mdebug "verbose: $verbose"
mdebug "action: $action"
mdebug "mic: $mic"
mdebug "Zoom Meeting shortcut: '$meeting_label'"
mdebug "Zoom Meeting ID: '$meeting_id'"
mdebug "Zoom Meeting password: '$meeting_pwd_label'"
mdebug "Zoom Meeting target: '$meeting_target'"
mdebug "Launcher: '$launcher'"


# -------------------------------------------------------------------------
# Actions
# -------------------------------------------------------------------------

if [[ $action == "test" ]]; then
    how=${meeting_id:-webrtc}
    if [[ $how == "webrtc" ]]; then
        xdg-open "https://webrtc.github.io/samples/src/content/devices/input-output/"
    elif [[ $how == "mic" ]]; then
        mic_test 0
    else
        merror "Unknown 'test': ${how}"
    fi
    exit 0
elif [[ $action == "info" ]]; then
    file="$(zm_addressbook_file)"
    ## Show address book or specific contact?
    if [[ -z "$meeting_id" ]]; then
      echo "'zm' address book ('$file'):"
      echo "-----------------------------------------------------"
      echo
      cat "$file"
    else
      echo "Zoom Details from '$file':"
      echo "-----------------------------------------------------"
      echo " shortcut: $meeting_label"
      echo "  meeting: $meeting_id"
      echo " password: $meeting_pwd_label"
      echo "  browser: $(zoom_url browser join "$meeting_id" "$meeting_pwd")"
      echo "   client: $(zoom_url client  join "$meeting_id" "$meeting_pwd")"
      echo "      url: $(zoom_url generic join "$meeting_id" "$meeting_pwd")"
      echo "  comment: $(zoom_quick_meeting_comment "$meeting_label")"
    fi
    _exit 0
elif [[ $action == "join" ]]; then
    [[ -n "$meeting_id" ]] || { merror "Zoom Meeting ID not specified"; }

    if [[ -n "$mic" ]]; then
        mic_set "$mic"
    fi
    
    ## Run a microphone test first?
    if $mictest; then
        mic_test 0
    fi
    
    url=$(zoom_url "$meeting_target" join "$meeting_id" "$meeting_pwd")
    cmd="\"$launcher\" \"$url\" &> /dev/null"
    mdebug "Calling: $cmd"
    minfo "Opening: $url"
    $dryrun || eval "$cmd"
    exit_value=$?
    _exit "${exit_value}"
elif [[ $action == "kill" ]]; then
    pkill zoom
    exit_value=$?
    mdebug "Killed 'zoom' process (exit code=$exit_value)"
    _exit "${exit_value}"
elif [[ $action == "mictest" ]]; then
    mic_test
    exit_value=$?
    _exit "${exit_value}"
fi

_exit 0
